{
  "base_branch": "main",
  "test": "npm test",
  "integration_test": "npm run test:integration",
  "e2e_test": "npx playwright test",
  "lint": "npm run lint",
  "typecheck": "npm run typecheck",
  "format": "",
  "test_globs": [
    "**/*.test.*",
    "**/*.spec.*",
    "**/test_*.py",
    "**/*_test.py",
    "**/*_test.go",
    "tests/**",
    "test/**",
    "__tests__/**",
    "src/test/**",
    "e2e/**",
    "**/*.e2e.*"
  ],
  "ui": {
    "enabled": false,
    "start_command": "npm run dev",
    "base_url": "http://localhost:3000",
    "viewports": [
      "desktop",
      "mobile"
    ],
    "visual_snapshots": true,
    "accessibility": true
  },
  "docs": {
    "level": "light"
  },
  "product_review": "auto",
  "review": {
    "models": [
      "opus",
      "sonnet"
    ]
  },
  "scope_lock": true,
  "reflect": {
    "after_each_story": true,
    "retro_every_n_stories": 10
  },
  "ship": {
    "mode": "commit",
    "auto_merge": true
  },
  "guard": {
    "ignore": []
  },
  "light_mode": "auto",
  "models": {
    "memory-keeper": "sonnet",
    "doc-writer": "sonnet",
    "integration-tester": "sonnet",
    "ui-tester": "sonnet"
  },
  "impact": {
    "enabled": true,
    "max_depth": 3
  },
  "claim": {
    "push_early": true
  },
  "require_plan_approval": true,
  "max_fix_cycles": 4,
  "max_stop_blocks": 3,
  "parallel": {
    "max_workers": 1
  },
  "bits_mode": {
    "default_mode": "auto",
    "risk_policy": "enforce-minimum-mode",
    "max_task_retries": 2,
    "require_evidence_for_done": true,
    "require_independent_verification": true,
    "missing_required_check": "block",
    "goal_loop": {
      "max_attempts": 4,
      "no_progress_passes": 1,
      "max_runtime_minutes": 90
    },
    "external_triggers": {
      "enabled": false,
      "require_explicit_opt_in": true
    },
    "report_cost_when_available": true
  }
}
